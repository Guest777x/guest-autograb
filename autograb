-- ============================================================
-- ANTI-DIE (identical to 0.1)
-- ============================================================
do
	local Workspace = game:GetService("Workspace")
	local connections = {}
	local function enableAntiDie()
		local char = LP.Character; if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
		local healthConn = hum:GetPropertyChangedSignal("Health"):Connect(function()
			if hum.Health <= 0 then hum.Health = hum.MaxHealth end
		end)
		table.insert(connections, healthConn)
		local diedConn = hum.Died:Connect(function()
			task.wait()
			pcall(function()
				local newHum = Instance.new("Humanoid")
				newHum.Name = "Humanoid"; newHum.Parent = char
				if Workspace.CurrentCamera then Workspace.CurrentCamera.Subject = newHum end
				hum:Destroy()
			end)
		end)
		table.insert(connections, diedConn)
	end
	local function setup()
		for _, conn in pairs(connections) do pcall(conn.Disconnect, conn) end
		connections = {}
		enableAntiDie()
	end
	setup()
	LP.CharacterAdded:Connect(function() task.wait(0.1); setup() end)
end

Steal.AutoStealEnabled = true
pcall(startAutoSteal)
