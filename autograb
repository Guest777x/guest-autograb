	local FILL_DURATION = 0.1
	local _lastPct = 0
	RunService.RenderStepped:Connect(function()
		if not frame.Visible then return end
		local target = 0
		if isStealing and stealStartTime then
			target = math.clamp((tick() - stealStartTime) / FILL_DURATION, 0, 1)
		elseif Steal.AutoStealEnabled then
			target = (findNearestPrompt() and 1 or 0)
		end
		_lastPct = _lastPct + (target - _lastPct) * 0.22
		local f = math.clamp(_lastPct, 0, 1)
		fill.Size = UDim2.new(f, -6 * f, 1, -6)
		if _lastPct >= 0.87 then
			pct.Text = "GUEST // READY"
