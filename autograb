-- Guest Scripts | guest loader | sector build v5
-- Drop-in. Auto-starts. Fire-and-forget. Parallel grabs.

repeat task.wait() until game:IsLoaded()
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local TS         = game:GetService("TweenService")
local UIS        = game:GetService("UserInputService")
local LP         = Players.LocalPlayer

local Steal = {
	AutoStealEnabled = true,
	StealRadius      = 200,
	HoldWait         = 0.0,   -- 0 = fire Triggered immediately after HoldBegan
	TailWait         = 0.0,
	MaxConcurrent    = 8,     -- parallel fires in flight
	Data             = {},
	_hasGC           = (type(getconnections) == "function"),
	_hasFPP          = (type(fireproximityprompt) == "function"),
}

local inFlight       = 0
local stealStartTime = nil
local autoConn       = nil
local progressFill, progressPct

local function promptHoldDuration(prompt)
	local ok, v = pcall(function() return prompt.HoldDuration end)
	if ok and type(v) == "number" then return v end
	return 0
end

local function promptEnabled(prompt)
	local ok, v = pcall(function() return prompt.Enabled end)
	if ok then return v end
	return true
end

local function getEntry(prompt)
	local e = Steal.Data[prompt]
	if e then return e end
	e = {
		hold    = {},
		trigger = {},
		path    = nil,
		ready   = true,
	}
	if Steal._hasGC then
		local okh, hc = pcall(getconnections, prompt.PromptButtonHoldBegan)
		if okh and hc then
			for _, c in ipairs(hc) do
				if c.Function then table.insert(e.hold, c.Function) end
			end
		end
		local okt, tc = pcall(getconnections, prompt.Triggered)
		if okt and tc then
			for _, c in ipairs(tc) do
				if c.Function then table.insert(e.trigger, c.Function) end
			end
		end
		if #e.hold > 0 or #e.trigger > 0 then e.path = "gc" end
	end
	if not e.path and Steal._hasFPP then e.path = "fpp" end
	if not e.path then e.path = "input" end
	Steal.Data[prompt] = e
	return e
end

local function fireGC(e)
	for _, fn in ipairs(e.hold) do task.spawn(fn) end
	if Steal.HoldWait > 0 then task.wait(Steal.HoldWait) end
	for _, fn in ipairs(e.trigger) do task.spawn(fn) end
	if Steal.TailWait > 0 then task.wait(Steal.TailWait) end
end

local function fireFPP(e, prompt)
	pcall(fireproximityprompt, prompt)
	if Steal.TailWait > 0 then task.wait(Steal.TailWait) end
end

local function fireInput(e, prompt)
	local okB = pcall(function() prompt:InputHoldBegin() end)
	if Steal.HoldWait > 0 then task.wait(Steal.HoldWait) end
	if okB then pcall(function() prompt:InputHoldEnd() end) end
	if Steal.TailWait > 0 then task.wait(Steal.TailWait) end
end

local FIRE = { gc = fireGC, fpp = fireFPP, input = fireInput }

local function firePrompt(prompt, e)
	local path = e.path
	if path == "gc" and #e.hold == 0 and #e.trigger == 0 then
		path = Steal._hasFPP and "fpp" or "input"
		e.path = path
	end
	local fn = FIRE[path]
	if not fn then return end
	local ok = pcall(fn, e, prompt)
	if not ok then
		if path == "gc" and Steal._hasFPP then
			e.path = "fpp"; pcall(fireFPP, e, prompt)
		elseif path ~= "input" then
			e.path = "input"; pcall(fireInput, e, prompt)
		end
	end
end

local function isMyPlotByName(plotName)
	local plots = workspace:FindFirstChild("Plots"); if not plots then return false end
	local plot  = plots:FindFirstChild(plotName);       if not plot  then return false end
	local sign  = plot:FindFirstChild("PlotSign")
	if sign then
		local yb = sign:FindFirstChild("YourBase")
		if yb and yb:IsA("BillboardGui") then return yb.Enabled == true end
	end
	return false
end

local function getRoot()
	local char = LP.Character; if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
end

local function findPromptOnSpawn(sp)
	local att = sp:FindFirstChild("PromptAttachment")
	if att then
		for _, pr in ipairs(att:GetChildren()) do
			if pr:IsA("ProximityPrompt")
				and pr.ActionText and pr.ActionText:find("Steal")
				and promptEnabled(pr) then
				return pr
			end
		end
	end
	for _, pr in ipairs(sp:GetDescendants()) do
		if pr:IsA("ProximityPrompt")
			and pr.ActionText and pr.ActionText:find("Steal")
			and promptEnabled(pr) then
			return pr
		end
	end
	return nil
end

local function findNearestPrompt()
	local root = getRoot(); if not root then return nil end
	local plots = workspace:FindFirstChild("Plots"); if not plots then return nil end
	local nearest, bestD2 = nil, math.huge
	local r2 = Steal.StealRadius * Steal.StealRadius
	local rx, ry, rz = root.Position.X, root.Position.Y, root.Position.Z
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:IsA("Model") and not isMyPlotByName(plot.Name) then
			local pods = plot:FindFirstChild("AnimalPodiums")
			if pods then
				for _, pod in ipairs(pods:GetChildren()) do
					local base = pod:FindFirstChild("Base")
					local sp = base and base:FindFirstChild("Spawn")
					if sp then
						local dx = sp.Position.X - rx
						local dy = sp.Position.Y - ry
						local dz = sp.Position.Z - rz
						local d2 = dx*dx + dy*dy + dz*dz
						if d2 <= r2 and d2 < bestD2 then
							local pr = findPromptOnSpawn(sp)
							if pr and getEntry(pr) then
								nearest, bestD2 = pr, d2
							end
						end
					end
				end
			end
		end
	end
	return nearest
end

local function executeSteal(prompt)
	if inFlight >= Steal.MaxConcurrent then return end
	local e = getEntry(prompt)
	if not e.ready then return end
	e.ready = false
	inFlight = inFlight + 1
	if inFlight == 1 then stealStartTime = tick() end
	task.spawn(function()
		firePrompt(prompt, e)
		e.ready = true
		inFlight = inFlight - 1
		if inFlight == 0 then stealStartTime = nil end
	end)
end

local function startAutoSteal()
	if autoConn then return end
	autoConn = RunService.Heartbeat:Connect(function()
		if not Steal.AutoStealEnabled then return end
		if inFlight >= Steal.MaxConcurrent then return end
		local p = findNearestPrompt()
		if p then executeSteal(p) end
	end)
end

