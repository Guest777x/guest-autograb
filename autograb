-- ---------- executor capability probe ----------
local function resolveFire()
	if type(getconnections) == "function" then
		return function(prompt)
			local d = Steal.Data[prompt]
			for _, fn in ipairs(d.hold)    do task.spawn(fn) end
			task.wait(Steal.HoldMin + math.random() * (Steal.HoldMax - Steal.HoldMin))
			for _, fn in ipairs(d.trigger) do task.spawn(fn) end
			if Steal.TailMax > 0 then
				task.wait(Steal.TailMin + math.random() * (Steal.TailMax - Steal.TailMin))
			end
		end
	end
	if type(fireproximityprompt) == "function" then
		return function(prompt)
			pcall(fireproximityprompt, prompt)
			if Steal.TailMax > 0 then
				task.wait(Steal.TailMin + math.random() * (Steal.TailMax - Steal.TailMin))
			end
		end
	end
	return function(prompt)
		local ok = pcall(function() prompt:InputHoldBegin() end)
		task.wait(Steal.HoldMin + math.random() * (Steal.HoldMax - Steal.HoldMin))
		if ok then pcall(function() prompt:InputHoldEnd() end) end
		if Steal.TailMax > 0 then
			task.wait(Steal.TailMin + math.random() * (Steal.TailMax - Steal.TailMin))
		end
	end
end
Steal._firePrompt = resolveFire()

-- ---------- helpers ----------
local function isMyPlotByName(plotName)
	local plots = workspace:FindFirstChild("Plots"); if not plots then return false end
	local plot  = plots:FindFirstChild(plotName);       if not plot  then return false end
	local sign  = plot:FindFirstChild("PlotSign")
	if sign then
		local yb = sign:FindFirstChild("YourBase")
		if yb and yb:IsA("BillboardGui") then return yb.Enabled == true end
	end
	return false
end

local function getRoot()
	local char = LP.Character; if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
end

local function cachePrompt(prompt)
	if Steal.Data[prompt] then return end
	local entry = { hold = {}, trigger = {}, ready = true, cached = false }
	if type(getconnections) == "function" then
		local ok1, hc = pcall(getconnections, prompt.PromptButtonHoldBegan)
		if ok1 and hc then
			for _, c in ipairs(hc) do
				if c.Function then table.insert(entry.hold, c.Function) end
			end
		end
		local ok2, tc = pcall(getconnections, prompt.Triggered)
		if ok2 and tc then
			for _, c in ipairs(tc) do
				if c.Function then table.insert(entry.trigger, c.Function) end
			end
		end
		entry.cached = (#entry.hold > 0 or #entry.trigger > 0)
	end
	Steal.Data[prompt] = entry
end

local function findNearestPrompt()
	local root = getRoot(); if not root then return nil end
	local plots = workspace:FindFirstChild("Plots"); if not plots then return nil end
	local nearest, dist = nil, math.huge
	local r2 = Steal.StealRadius * Steal.StealRadius
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:IsA("Model") and not isMyPlotByName(plot.Name) then
			local pods = plot:FindFirstChild("AnimalPodiums")
			if pods then
				for _, pod in ipairs(pods:GetChildren()) do
					local base = pod:FindFirstChild("Base")
					local sp = base and base:FindFirstChild("Spawn")
					if sp then
						local d2 = (sp.Position - root.Position).Magnitude
						d2 = d2 * d2
						if d2 <= r2 and d2 < dist then
							local found = nil
							local att = sp:FindFirstChild("PromptAttachment")
							if att then
								for _, pr in ipairs(att:GetChildren()) do
									if pr:IsA("ProximityPrompt")
										and pr.ActionText
										and pr.ActionText:find("Steal") then
										found = pr; break
									end
								end
							end
							if not found then
								for _, pr in ipairs(sp:GetDescendants()) do
									if pr:IsA("ProximityPrompt")
										and pr.ActionText
										and pr.ActionText:find("Steal") then
										found = pr; break
									end
								end
							end
							if found then
								cachePrompt(found)
								nearest, dist = found, d2
							end
						end
					end
				end
			end
		end
	end
	return nearest
end

local function executeSteal(prompt)
	if isStealing then return end
	cachePrompt(prompt)
	local data = Steal.Data[prompt]
	if not data or not data.ready then return end
	data.ready = false
	isStealing = true
	stealStartTime = tick()
	task.spawn(function()
		Steal._firePrompt(prompt)
		data.ready = true
		isStealing = false
	end)
end

-- ---------- auto loop ----------
local function startAutoSteal()
	if autoConn then return end
	autoConn = RunService.Heartbeat:Connect(function()
		if not Steal.AutoStealEnabled or isStealing then return end
		if math.random() > Steal.CadenceMax then return end
		local p = findNearestPrompt()
		if p then executeSteal(p) end
	end)
end

local function stopAutoSteal()
	if autoConn then autoConn:Disconnect(); autoConn = nil end
	isStealing = false
end

