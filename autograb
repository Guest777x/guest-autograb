-- ---------- anti-die (identical to v6) ----------
do
	local conns = {}
	local function enable()
		local char = LP.Character; if not char then return end
		local hum  = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
		table.insert(conns, hum:GetPropertyChangedSignal("Health"):Connect(function()
			if hum.Health <= 0 and hum.MaxHealth - hum.Health < 15 then
				hum.Health = hum.MaxHealth
			end
		end))
	end
	local function reset()
		for _, c in pairs(conns) do pcall(c.Disconnect, c) end
		conns = {}
		enable()
	end
	reset()
	LP.CharacterAdded:Connect(function() task.wait(); reset() end)
end

-- ---------- invalidate spawn cache ----------
do
	local plots = workspace:FindFirstChild("Plots")
	if plots then
		plots.ChildAdded:Connect(function() _spawnCacheDirty = true end)
		plots.ChildRemoved:Connect(function() _spawnCacheDirty = true end)
	end
end
LP.CharacterAdded:Connect(function()
	table.clear(Steal.Data)
	_spawnCacheDirty = true
end)

